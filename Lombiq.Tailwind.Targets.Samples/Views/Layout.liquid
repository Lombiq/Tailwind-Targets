<!DOCTYPE html>
<html lang="{{ Culture.Name }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ "PageTitle" | shape_new | shape_stringify }}</title>

    {% assign stylesUrl = "~/Lombiq.Tailwind.Targets.Samples/css/site.css" | href %}
    {% style src:stylesUrl, append_version:"true" %}

    {% resources type: "HeadScript" %}
    {% resources type: "HeadLink" %}
    {% resources type: "Stylesheet" %}
    {% render_section "HeadMeta", required: false %}
</head>
<body dir="{{ Culture.Dir }}" class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
        <div data-tailwind-targets-sample class="w-full rounded-3xl border border-white/10 bg-white/5 p-10 shadow-2xl shadow-black/30">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Lombiq Tailwind Targets</p>
            <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight text-white">Tailwind Targets sample theme</h1>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">
                This layout is styled from the generated Tailwind output of the sample theme.
            </p>

            <div class="mt-10">
                {% render_body %}
            </div>
        </div>
    </div>

    {% resources type: "FootScript" %}
</body>
</html>
