{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'github>Lombiq/Open-Source-Orchard-Core-Extensions:renovate-osoce-orchard-core-submodule.json5',
    ],
    customManagers: [
        {
            // Lombiq.Tailwind.Targets pins the upstream Tailwind CLI version in an MSBuild property.
            customType: 'regex',
            managerFilePatterns: [
                '/(^|/)Lombiq\\.Tailwind\\.Targets/Lombiq\\.Tailwind\\.Targets\\.props$/',
            ],
            depNameTemplate: 'tailwindlabs/tailwindcss',
            matchStrings: [
                "<TailwindCliVersion Condition=\"'\\$\\(TailwindCliVersion\\)' == ''\">(?<currentValue>[^<]+)</TailwindCliVersion>",
            ],
            datasourceTemplate: 'github-releases',
            versioningTemplate: 'semver',
        },
    ],
}
